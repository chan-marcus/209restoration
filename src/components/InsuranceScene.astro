---
// Insurance / documentation scene: a phone photographing day-one evidence (a
// water stain on the wall) beside a cause-of-loss scope showing which perils
// read as covered vs excluded. Documentation wins the gray zone.
---
<svg class="insurance-scene" viewBox="0 0 640 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a phone photographing water damage next to an insurance scope listing covered and excluded causes of loss">
  <!-- night room -->
  <rect x="0" y="0" width="640" height="420" fill="#081722"/>
  <rect x="30" y="30" width="580" height="330" rx="6" fill="#102a38"/>

  <!-- header label -->
  <g font-family="IBM Plex Mono, monospace" letter-spacing="2" fill="#3ec6d8">
    <text x="58" y="66" font-size="13" opacity="0.95">CAUSE OF LOSS</text>
    <line x1="58" y1="74" x2="288" y2="74" stroke="#3ec6d8" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.6"/>
  </g>

  <!-- LEFT: wall section with a spreading water stain being photographed -->
  <rect x="58" y="96" width="196" height="176" rx="4" fill="#0c2230"/>
  <!-- stain: concentric bloom -->
  <g opacity="0.9">
    <ellipse cx="150" cy="188" rx="66" ry="52" fill="#5c3f24"/>
    <ellipse cx="150" cy="188" rx="46" ry="36" fill="#71512f"/>
    <ellipse cx="150" cy="188" rx="26" ry="20" fill="#8a6a48"/>
  </g>
  <!-- moisture-reading ring overlay -->
  <ellipse cx="150" cy="188" rx="78" ry="60" fill="none" stroke="#3ec6d8" stroke-width="2" stroke-dasharray="6 5" opacity="0.55"/>

  <!-- phone framing the shot, flash cone toward the wall -->
  <g>
    <path d="M254 150 L330 150 L330 250 L254 250 Z" fill="#3ec6d8" opacity="0.08"/>
    <line x1="254" y1="150" x2="330" y2="130" stroke="#3ec6d8" stroke-width="1.5" opacity="0.4"/>
    <line x1="254" y1="250" x2="330" y2="270" stroke="#3ec6d8" stroke-width="1.5" opacity="0.4"/>
    <rect x="330" y="128" width="38" height="150" rx="8" fill="#0c2230" stroke="#255264" stroke-width="3" transform="rotate(90 349 203)"/>
    <!-- viewfinder capturing the stain -->
    <rect x="326" y="176" width="46" height="54" rx="3" fill="#102a38"/>
    <ellipse cx="349" cy="203" rx="14" ry="11" fill="#5c3f24"/>
    <!-- lens + capture dot -->
    <circle cx="349" cy="150" r="5" fill="#255264"/>
    <circle cx="349" cy="150" r="2" fill="#3ec6d8"/>
    <text x="322" y="252" font-family="IBM Plex Mono, monospace" font-size="9" letter-spacing="1.5" fill="#3ec6d8" opacity="0.8">DAY 1</text>
  </g>

  <!-- RIGHT: the scope / cause-of-loss checklist -->
  <g>
    <rect x="392" y="92" width="196" height="228" rx="8" fill="#eef4f4"/>
    <!-- clipboard clip -->
    <rect x="466" y="84" width="48" height="16" rx="5" fill="#93abb4"/>
    <!-- title bar -->
    <rect x="410" y="112" width="120" height="10" rx="3" fill="#0c2230"/>
    <rect x="410" y="128" width="80" height="7" rx="3" fill="#93abb4"/>

    <!-- COVERED rows: cyan check -->
    <g>
      <circle cx="420" cy="164" r="9" fill="#0d94a8"/>
      <path d="M415 164 l4 4 l7 -8" stroke="#eef4f4" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <rect x="438" y="160" width="120" height="8" rx="3" fill="#33454f"/>
      <rect x="438" y="172" width="70" height="6" rx="3" fill="#a9bcc4"/>
    </g>
    <g>
      <circle cx="420" cy="204" r="9" fill="#0d94a8"/>
      <path d="M415 204 l4 4 l7 -8" stroke="#eef4f4" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <rect x="438" y="200" width="108" height="8" rx="3" fill="#33454f"/>
      <rect x="438" y="212" width="84" height="6" rx="3" fill="#a9bcc4"/>
    </g>

    <!-- EXCLUDED rows: dim dashed / cross -->
    <g opacity="0.75">
      <circle cx="420" cy="244" r="9" fill="none" stroke="#c0563f" stroke-width="2.5"/>
      <path d="M416 240 l8 8 M424 240 l-8 8" stroke="#c0563f" stroke-width="2.5" stroke-linecap="round"/>
      <rect x="438" y="240" width="96" height="8" rx="3" fill="#8fa2ab"/>
      <rect x="438" y="252" width="64" height="6" rx="3" fill="#c3d0d6"/>
    </g>
    <g opacity="0.75">
      <circle cx="420" cy="284" r="9" fill="none" stroke="#c0563f" stroke-width="2.5"/>
      <path d="M416 280 l8 8 M424 280 l-8 8" stroke="#c0563f" stroke-width="2.5" stroke-linecap="round"/>
      <rect x="438" y="280" width="112" height="8" rx="3" fill="#8fa2ab"/>
      <rect x="438" y="292" width="58" height="6" rx="3" fill="#c3d0d6"/>
    </g>

    <!-- column legend down the side -->
    <text x="392" y="150" font-family="IBM Plex Mono, monospace" font-size="9" letter-spacing="1.5" fill="#0d94a8" transform="rotate(-90 392 150)">COVERED</text>
    <text x="392" y="284" font-family="IBM Plex Mono, monospace" font-size="9" letter-spacing="1.5" fill="#c0563f" opacity="0.85" transform="rotate(-90 392 284)">EXCLUDED</text>

    <!-- pen resting on the scope -->
    <g transform="rotate(24 548 300)">
      <rect x="500" y="296" width="96" height="9" rx="3" fill="#255264"/>
      <path d="M596 296 l14 4.5 l-14 4.5 Z" fill="#3ec6d8"/>
      <rect x="500" y="296" width="14" height="9" rx="2" fill="#0c2230"/>
    </g>
  </g>
</svg>

<style>
  .insurance-scene {
    width: 100%; height: auto; display: block;
    border-radius: 20px;
    border: 1px solid rgba(14, 36, 51, 0.12);
    box-shadow: 0 24px 64px rgba(14, 36, 51, 0.18);
  }
</style>
