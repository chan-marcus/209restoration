---
// First-hour response: homeowner (not a crew) reacting in the dark:
// one hand shutting the main valve, phone lit in the other, clock on the
// wall, breaker panel, and a shallow puddle just starting to spread.
---
<svg class="first-hour-scene" viewBox="0 0 640 420" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration of a homeowner shutting off the water main and calling for help in the first hour of a leak">
  <!-- night room -->
  <rect x="0" y="0" width="640" height="420" fill="#081722"/>
  <rect x="30" y="30" width="580" height="330" rx="6" fill="#102a38"/>

  <!-- wall clock, early hours -->
  <circle cx="150" cy="96" r="30" fill="#0c2230" stroke="#1d4456" stroke-width="4"/>
  <circle cx="150" cy="96" r="2.5" fill="#eef4f4"/>
  <line x1="150" y1="96" x2="150" y2="77" stroke="#eef4f4" stroke-width="3" stroke-linecap="round" transform="rotate(30 150 96)"/>
  <line x1="150" y1="96" x2="150" y2="82" stroke="#eef4f4" stroke-width="3" stroke-linecap="round" transform="rotate(-120 150 96)"/>

  <!-- breaker panel, one main flipped off -->
  <rect x="60" y="168" width="60" height="86" rx="5" fill="#1d4456" stroke="#0c2230" stroke-width="3"/>
  <rect x="70" y="180" width="40" height="10" rx="2" fill="#0c2230"/>
  <g fill="#255264">
    <rect x="72" y="198" width="16" height="7" rx="2"/><rect x="92" y="198" width="16" height="7" rx="2"/>
    <rect x="72" y="210" width="16" height="7" rx="2"/><rect x="92" y="210" width="16" height="7" rx="2"/>
    <rect x="72" y="222" width="16" height="7" rx="2"/><rect x="92" y="222" width="16" height="7" rx="2"/>
  </g>
  <!-- main breaker: thrown to off, warm highlight -->
  <rect x="72" y="234" width="36" height="9" rx="2" fill="#ff5238"/>
  <text x="60" y="266" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1.5" fill="#3ec6d8" opacity="0.8">POWER OFF</text>

  <!-- header label -->
  <g font-family="IBM Plex Mono, monospace" letter-spacing="2" fill="#3ec6d8">
    <text x="352" y="70" font-size="13" opacity="0.95">FIRST HOUR</text>
    <line x1="352" y1="78" x2="582" y2="78" stroke="#3ec6d8" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.6"/>
  </g>

  <!-- water main pipe + red shutoff wheel near the floor -->
  <rect x="292" y="252" width="9" height="70" fill="#93abb4"/>
  <rect x="288" y="248" width="17" height="8" rx="2" fill="#93abb4"/>
  <circle cx="296" cy="238" r="15" fill="none" stroke="#ff5238" stroke-width="5"/>
  <circle cx="296" cy="238" r="3.5" fill="#ff5238"/>
  <g stroke="#ff5238" stroke-width="4" stroke-linecap="round">
    <line x1="296" y1="238" x2="296" y2="225"/>
    <line x1="296" y1="238" x2="307" y2="245"/>
    <line x1="296" y1="238" x2="285" y2="245"/>
  </g>

  <!-- homeowner: casual clothes, crouched, one hand on the valve, phone lit in the other -->
  <g>
    <!-- back leg + front leg down to floor -->
    <path d="M392 258 l-10 66 h15 l6 -50" fill="#0c2230"/>
    <path d="M420 258 l12 66 h-15 l-4 -40" fill="#16323f"/>
    <!-- torso: hoodie -->
    <path d="M382 196 q30 -12 58 0 l4 66 q-33 12 -66 0 Z" fill="#2f6274"/>
    <path d="M382 196 q30 -12 58 0 l2 22 q-31 10 -62 0 Z" fill="#356b7e"/>
    <!-- reaching arm to the valve -->
    <path d="M388 214 q-46 8 -84 24" stroke="#2f6274" stroke-width="13" stroke-linecap="round" fill="none"/>
    <circle cx="304" cy="240" r="8" fill="#e8b48c"/>
    <!-- phone arm, bent up toward face -->
    <path d="M436 210 q26 -6 32 -34" stroke="#2f6274" stroke-width="13" stroke-linecap="round" fill="none"/>
    <circle cx="470" cy="176" r="7.5" fill="#e8b48c"/>
    <!-- glowing phone -->
    <rect x="462" y="150" width="20" height="34" rx="4" fill="#0c2230" stroke="#3ec6d8" stroke-width="2"/>
    <rect x="465" y="155" width="14" height="24" rx="2" fill="#3ec6d8" opacity="0.85"/>
    <ellipse cx="472" cy="167" rx="30" ry="20" fill="#3ec6d8" opacity="0.12"/>
    <!-- head + hair -->
    <circle cx="416" cy="176" r="16" fill="#e8b48c"/>
    <path d="M400 174 a16 16 0 0 1 32 0 q-8 -9 -16 -8 q-9 -1 -16 8 Z" fill="#16323f"/>
  </g>

  <!-- shallow puddle just starting to spread from the pipe base -->
  <path d="M60 336 q40 -8 90 -4 q60 -20 150 -6 q120 10 260 2 q40 -2 60 6 L580 356 L60 356 Z" fill="#155a6b" opacity="0.75"/>
  <path d="M60 332 q60 -14 150 -6 q120 12 300 2" stroke="#3ec6d8" stroke-width="2.5" fill="none" opacity="0.85"/>
  <!-- ripple rings where water meets the pipe -->
  <g stroke="#eef4f4" stroke-width="1.8" fill="none" opacity="0.4">
    <path d="M270 338 q26 -7 52 0"/>
    <path d="M262 346 q34 -8 68 0"/>
  </g>

  <!-- foil under a furniture leg, off to the side -->
  <rect x="524" y="300" width="52" height="34" rx="3" fill="#1d4456"/>
  <rect x="544" y="334" width="10" height="6" fill="#0c2230"/>
  <rect x="536" y="338" width="26" height="5" rx="2" fill="#93abb4" opacity="0.8"/>
</svg>

<style>
  .first-hour-scene {
    width: 100%; height: auto; display: block;
    border-radius: 20px;
    border: 1px solid rgba(14, 36, 51, 0.12);
    box-shadow: 0 24px 64px rgba(14, 36, 51, 0.2);
  }
</style>
