---
// Interactive service-area map (Maps JavaScript API). Shades the whole service
// region — San Joaquin and Stanislaus Counties — and marks the named cities
// inside it, fitting the view to the full coverage.
// Needs PUBLIC_GOOGLE_MAPS_API_KEY with the Maps JavaScript API enabled and
// allowed on the key. Falls back to a keyless iframe of the region when no key
// is present, so local dev without a key still renders something.
import MapEmbed from './MapEmbed.astro';
import { CITIES } from '../data/cities';
import { SITE } from '../config/site';
import serviceAreaGeoJson from '../data/service-area.geojson.json';

interface Props {
  title: string;     // accessible label
  caption?: string;
}
const { title, caption } = Astro.props;
const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
const areas = CITIES.map((c) => ({ name: c.name, county: c.county, lat: c.lat, lng: c.lng }));
---
{apiKey ? (
  <figure class="map-embed">
    <div class="map-frame">
      <div id="service-area-map" class="js-map" role="application" aria-label={title}></div>
    </div>
    {caption && <figcaption class="mono">{caption}</figcaption>}
  </figure>

  <script define:vars={{ apiKey, areas, geojson: serviceAreaGeoJson }}>
    // Brand colors pulled to match the site's cyan accent.
    const FILL = '#3ec6d8';
    const STROKE = '#0d94a8';

    // Build the map only once the container actually has a size. Google's
    // callback fires before layout settles, and a map created against a 0x0
    // element caches that size and never renders — the container measures
    // correctly afterwards, but the map stays blank. Re-running init by hand
    // after layout rendered it fine, which is what pinned this down.
    function whenSized(el, cb) {
      if (el.offsetWidth > 0 && el.offsetHeight > 0) return cb();
      if (typeof ResizeObserver === 'function') {
        const ro = new ResizeObserver(() => {
          if (el.offsetWidth > 0 && el.offsetHeight > 0) { ro.disconnect(); cb(); }
        });
        ro.observe(el);
      } else {
        window.addEventListener('load', cb, { once: true });
      }
    }

    window.initServiceAreaMap = function () {
      const el = document.getElementById('service-area-map');
      if (!el) return;
      whenSized(el, function () { buildServiceAreaMap(el); });
    };

    function buildServiceAreaMap(el) {
      const map = new google.maps.Map(el, {
        // A map built without center+zoom never renders, even when fitBounds()
        // is later called with valid bounds — verified against a live control
        // map. fitBounds below still refines this to the shaded counties.
        center: { lat: 37.78, lng: -121.15 },
        zoom: 9,
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true,
        clickableIcons: false,
        styles: [
          { featureType: 'poi', stylers: [{ visibility: 'off' }] },
          { featureType: 'transit', stylers: [{ visibility: 'off' }] }
        ]
      });

      // Shade the whole service region (the two counties).
      map.data.addGeoJson(geojson);
      map.data.setStyle({
        fillColor: FILL,
        fillOpacity: 0.2,
        strokeColor: STROKE,
        strokeOpacity: 0.9,
        strokeWeight: 2,
        clickable: false
      });

      // Fit the view to the full shaded coverage.
      const bounds = new google.maps.LatLngBounds();
      map.data.forEach((feature) => {
        feature.getGeometry().forEachLatLng((ll) => bounds.extend(ll));
      });

      // Mark the named cities inside the region for orientation.
      areas.forEach((a) => {
        new google.maps.Marker({
          map,
          position: { lat: a.lat, lng: a.lng },
          title: a.name + ' — ' + a.county,
          label: { text: a.name, fontSize: '11px', fontWeight: '600', color: '#0e2433' }
        });
      });

      map.fitBounds(bounds, 24);
    }

    (function loadMaps() {
      if (window.google && window.google.maps) { window.initServiceAreaMap(); return; }
      if (document.getElementById('gmaps-js')) return; // already loading
      const s = document.createElement('script');
      s.id = 'gmaps-js';
      s.async = true;
      s.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(apiKey) +
              '&callback=initServiceAreaMap&loading=async';
      document.head.appendChild(s);
    })();
  </script>
) : (
  <MapEmbed
    query={`${SITE.anchorCity}, ${SITE.anchorState}`}
    zoom={9}
    title={title}
    caption={caption}
  />
)}

<style>
  .map-embed { margin: 0; }
  .map-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(14, 36, 51, 0.12);
    box-shadow: 0 24px 64px rgba(14, 36, 51, 0.18);
    background: var(--panel);
  }
  .js-map { position: absolute; inset: 0; width: 100%; height: 100%; }
  figcaption {
    margin-top: 0.8rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--silt);
    text-transform: uppercase;
  }
</style>
