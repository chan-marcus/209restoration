---
import ContyntCredit from '../components/ContyntCredit.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.domain).href;

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': SITE.domain + '/#business',
  name: SITE.brand,
  description: 'Emergency water damage restoration dispatch serving San Joaquin and Stanislaus Counties. Open 24/7.',
  url: SITE.domain,
  telephone: SITE.phone,
  email: SITE.email,
  areaServed: [
    'Stockton CA', 'Modesto CA', 'Lodi CA', 'Tracy CA',
    'Manteca CA', 'Turlock CA', 'Lathrop CA', 'Ceres CA'
  ],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59'
  },
  priceRange: '$$'
};

// WebSite schema gives Google an explicit site name for the homepage title
// link, so results show "209 Restoration" instead of the bare domain.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': SITE.domain + '/#website',
  name: SITE.brand,
  alternateName: '209 Restoration Water Damage',
  url: SITE.domain + '/',
  publisher: { '@id': SITE.domain + '/#business' }
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0a1c2b" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:image" content={SITE.domain + '/og.png'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="/" aria-label={SITE.brand + ' home'}>
        <svg class="logo-mark" width="34" height="45" viewBox="0 -1.25 34 45" aria-hidden="true">
          <path d="M17 1 C17 1 32 18.5 32 27 a15 15 0 0 1 -30 0 C2 18.5 17 1 17 1 Z" fill="none" stroke="var(--cyan)" stroke-width="2.5"/>
          <path d="M4.5 27.5 q4 -3 8 0 t8 0 t8 0 l0 1 a13 13 0 0 1 -24.5 4 Z" fill="var(--cyan)" opacity="0.9"/>
        </svg>
        <span class="logo-text">209<em>Restoration</em></span>
      </a>
      <nav class="main-nav" aria-label="Main">
        <a href="/services/">Services</a>
        <a href="/areas/">Areas</a>
        <a href="/about/">About</a>
        <a href="/blog/">Guides</a>
        <a href="/contact/">Contact</a>
      </nav>
      <a class="header-call" href={`tel:${SITE.phone}`}>
        <span class="open-dot" aria-hidden="true"></span>
        <span class="header-call-text">
          <strong>{SITE.phoneDisplay}</strong>
          <small>{SITE.phoneDigits} &middot; 24/7</small>
        </span>
      </a>
      <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile menu" hidden>
    <a href="/services/">Services</a>
    <a href="/areas/">Areas</a>
    <a href="/about/">About</a>
    <a href="/blog/">Guides</a>
    <a href="/contact/">Contact</a>
    <a class="mobile-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="waterline" aria-hidden="true">
      <svg viewBox="0 0 1200 24" preserveAspectRatio="none"><path d="M0 12 q30 -10 60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0 t60 0" fill="none" stroke="var(--cyan)" stroke-width="2" opacity="0.5"/></svg>
    </div>
    <div class="wrap footer-grid">
      <div>
        <p class="footer-brand">209<em>Restoration</em></p>
        <p class="footer-tag">Water damage response for the Central Valley. One call, a local crew on the way.</p>
        <a class="btn-call" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
        <p class="footer-digits">{SITE.phoneDigits}</p>
        <p class="mono footer-hours">OPEN 24/7 &middot; NIGHTS &middot; WEEKENDS &middot; HOLIDAYS</p>
      </div>
      <nav aria-label="Services">
        <p class="footer-head">Services</p>
        <a href="/services/emergency-water-removal/">Water removal</a>
        <a href="/services/flood-damage-cleanup/">Flood cleanup</a>
        <a href="/services/sewage-cleanup/">Sewage cleanup</a>
        <a href="/services/burst-pipe-cleanup/">Burst pipes</a>
        <a href="/services/mold-remediation/">Mold remediation</a>
        <a href="/services/">All services &rarr;</a>
      </nav>
      <nav aria-label="Areas">
        <p class="footer-head">Areas</p>
        <a href="/areas/stockton/">Stockton</a>
        <a href="/areas/modesto/">Modesto</a>
        <a href="/areas/lodi/">Lodi</a>
        <a href="/areas/tracy/">Tracy</a>
        <a href="/areas/manteca/">Manteca</a>
        <a href="/areas/">All areas &rarr;</a>
      </nav>
      <nav aria-label="Company">
        <p class="footer-head">Company</p>
        <a href="/about/">About</a>
        <a href="/blog/">Guides</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
    <div class="wrap footer-legal">
      <p class="legal-line">{SITE.legalLine.split(/(?<=\.)\s+/).map((x) => <span>{x}</span>)}</p>
      <p>&copy; {new Date().getFullYear()} {SITE.brand}. All rights reserved.</p>
    </div>
    <div class="foot-credit"><ContyntCredit /></div>
  </footer>

  <a class="call-bar" href={`tel:${SITE.phone}`}>
    <span class="open-dot" aria-hidden="true"></span>
    <span class="call-bar-label">Water emergency? Open now</span>
    <strong>Call {SITE.phoneDisplay} &middot; Open 24/7</strong>
  </a>
  <script>
    const burger = document.getElementById('burger');
    const nav = document.getElementById('mobile-nav');
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      nav.hidden = open;
      document.body.style.overflow = open ? '' : 'hidden';
    });
    nav.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        burger.setAttribute('aria-expanded', 'false');
        nav.hidden = true;
        document.body.style.overflow = '';
      });
    });
  </script>
  <!-- Line fitting. The build joins the words around each sentence break
       with no-break spaces (scripts/typeset.mjs). That keeps sentences off
       line edges, but on a narrow screen it can leave short lines mid-
       paragraph. For each paragraph this tries the joined and unjoined text
       at a few near-invisible letter-spacing steps, and keeps whichever reads
       best at the reader's actual width: a sentence near a line edge costs
       3, a stub last line 2, a lone last word 4, a short inner line 1, and
       text overflowing its column 100. Proper nouns (.pn) are never unbound. -->
  <script is:inline>
    (function () {
      var STEPS = [0, -0.006, 0.006, -0.012, 0.012, -0.018, 0.018, -0.024, 0.024, -0.03, 0.03];
      var END = /[.?!]["')\u201d]?$/;
      var NB = /\u00a0/g;
      var saved = new WeakMap();
      function lines(el) {
        var out = [], walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), n, m, re;
        while ((n = walker.nextNode())) {
          re = /[^\s\u00a0]+/g;
          while ((m = re.exec(n.data))) {
            var r = document.createRange();
            r.setStart(n, m.index); r.setEnd(n, m.index + m[0].length);
            var rc = r.getClientRects();
            if (!rc.length) continue;
            var top = Math.round(rc[0].top), last = out[out.length - 1];
            var w = { w: m[0], l: rc[0].left, r: rc[rc.length - 1].right };
            if (last && Math.abs(last.top - top) < 6) last.ws.push(w); else out.push({ top: top, ws: [w] });
          }
        }
        return out;
      }
      function score(el) {
        var L = lines(el);
        if (L.length < 2) return 0;
        var cs = getComputedStyle(el);
        var box = el.getBoundingClientRect().width - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        var s = 0, width = 0, right = el.getBoundingClientRect().right - parseFloat(cs.paddingRight);
        L.forEach(function (l) {
          width = Math.max(width, l.ws[l.ws.length - 1].r - l.ws[0].l);
          if (l.ws[l.ws.length - 1].r > right + 1) s += 100; // a joined run overflowing its column
        });
        var lastL = L[L.length - 1], lw = lastL.ws[lastL.ws.length - 1].r - lastL.ws[0].l;
        if (lastL.ws.length === 1) s += 4;
        else if (lw < width * 0.3) s += 2;
        L.forEach(function (l, i) {
          var ws = l.ws, k;
          if (i > 0) for (k = 0; k < Math.min(2, ws.length - 1); k++) if (END.test(ws[k].w)) s += 3;
          if (i < L.length - 1) {
            for (k = Math.max(1, ws.length - 2); k < ws.length; k++) if (END.test(ws[k - 1].w)) s += 3;
            if (L.length > 2 && ws[ws.length - 1].r - ws[0].l < box * 0.62) s += 1;
          }
        });
        return s;
      }
      // Joined (as built) or unjoined text. Unjoining keeps the paragraph's
      // final no-break space, which holds the last two words together.
      function textNodes(el) {
        var out = [], w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), n;
        while ((n = w.nextNode())) out.push(n);
        return out;
      }
      function setJoined(el, on) {
        var nodes = textNodes(el), lastNode = null, i;
        for (i = nodes.length - 1; i >= 0; i--) if (nodes[i].data.indexOf('\u00a0') > -1) { lastNode = nodes[i]; break; }
        nodes.forEach(function (n) {
          if (!saved.has(n)) saved.set(n, n.data);
          var orig = saved.get(n);
          if (on) { n.data = orig; return; }
          if (n === lastNode) {
            var cut = orig.lastIndexOf('\u00a0');
            n.data = orig.slice(0, cut).replace(NB, ' ') + orig.slice(cut);
          } else n.data = orig.replace(NB, ' ');
        });
        el.querySelectorAll('.nw').forEach(function (x) { x.style.whiteSpace = on ? '' : 'normal'; });
      }
      function fit() {
        var els = document.querySelectorAll('main p, main li, main .sent, .footer-legal p');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          if (!el.getClientRects().length || el.querySelector('.sent')) continue;
          var joins = el.textContent.indexOf('\u00a0') > -1 ? [true, false] : [true];
          var best = Infinity, bestJ = true, bestStep = 0;
          for (var a = 0; a < joins.length && best > 0; a++) {
            setJoined(el, joins[a]);
            for (var j = 0; j < STEPS.length && best > 0; j++) {
              el.style.letterSpacing = STEPS[j] ? STEPS[j] + 'em' : '';
              var s = score(el) + (joins[a] ? 0 : 0.5);
              if (s < best) { best = s; bestJ = joins[a]; bestStep = STEPS[j]; }
            }
          }
          setJoined(el, bestJ);
          el.style.letterSpacing = bestStep ? bestStep + 'em' : '';
        }
      }
      var t, lastW = window.innerWidth;
      (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(fit);
      window.addEventListener('resize', function () {
        if (window.innerWidth === lastW) return;
        lastW = window.innerWidth;
        clearTimeout(t); t = setTimeout(fit, 150);
      });
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #f7fafb;
    --tint: #e6f4f6;
    --navy: #0a1c2b;
    --navy-2: #102a3d;
    --primary: #0d94a8;
    --primary-deep: #0a7486;
    --primary-bright: #67d3e0;
    --heading: #0e2433;
    --pulse: #10b981;

    /* contextual aliases: light theme defaults */
    --ink: var(--bg);
    --deep: #ffffff;
    --panel: #ffffff;
    --cyan: var(--primary);
    --cyan-dim: var(--primary-deep);
    --flare: var(--primary);
    --flare-deep: var(--primary-deep);
    --paper: var(--heading);
    --silt: #536674;
    --line: #e4ebee;

    --font-display: 'Plus Jakarta Sans', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: 'Inter', sans-serif;

    --shadow-sm: 0 1px 2px rgba(14, 36, 51, 0.05);
    --shadow-lg: 0 16px 44px rgba(14, 36, 51, 0.1);
  }

  /* dark surfaces re-scope the aliases */
  .cta-panel, .site-footer, .call-bar {
    --paper: #f2f8f9;
    --silt: #9cb3bf;
    --cyan: var(--primary-bright);
    --panel: var(--navy-2);
    --deep: var(--navy-2);
    --line: rgba(103, 211, 224, 0.15);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  /* Phones: the whole site is set at 90% (Marcus's rule for every site). Sizes
     are rem, so type and spacing shrink together; breakpoints stay put. */
  @media (max-width: 639.98px) { html { font-size: 90%; } }
  /* Bound by scripts/typeset.mjs at build time: .pn is a proper noun, .nw a
     hyphenated word inside a joined run. */
  .nw, .pn { white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }

  body {
    background: var(--bg);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 1.03rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 1.5rem; }

  h1, h2 {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.06;
    /* Tight tracking is intentional, but letter-spacing also shrinks the
       gap between words. word-spacing puts that gap back so headings do
       not read as one run-on word. Inherited, so scoped heading styles
       that re-declare letter-spacing get the correction too. */
    letter-spacing: -0.033em;
    word-spacing: 0.08em;
    color: var(--paper);
    text-wrap: balance;
  }
  h1 { font-size: clamp(2.6rem, 5.6vw, 4.1rem); }
  h2 { font-size: clamp(1.9rem, 3.6vw, 2.7rem); }
  h3 {
    font-family: var(--font-display); font-weight: 700; font-size: 1.08rem;
    letter-spacing: -0.015em; word-spacing: 0.04em; color: var(--paper); line-height: 1.35;
    text-wrap: balance;
  }

  p { color: var(--silt); }
  p, li, figcaption, dd { text-wrap: pretty; }
  strong { color: var(--paper); }
  a { color: var(--primary-deep); }

  .mono {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--primary-deep);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--tint);
    border: 1px solid rgba(13, 148, 168, 0.22);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary-deep);
    margin-bottom: 1.4rem;
  }

  .skip {
    position: absolute; left: -999px; top: 0;
    background: var(--navy); color: #fff; padding: 0.6rem 1rem; z-index: 100;
  }
  .skip:focus { left: 0; }

  :focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

  /* ---------- header ---------- */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(228, 235, 238, 0.9);
  }
  .header-inner {
    display: flex; align-items: center; gap: 1.5rem;
    padding-top: 0.9rem; padding-bottom: 0.9rem;
  }
  .logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .logo-mark { width: 27px; height: 36px; }
  .logo-text {
    font-family: var(--font-display); font-weight: 800;
    font-size: 1.32rem; color: var(--heading); letter-spacing: -0.03em;
  }
  .logo-text em { font-style: normal; color: var(--primary); margin-left: 0.22rem; }
  .main-nav { display: flex; gap: 1.8rem; margin-left: auto; }
  .main-nav a {
    color: #43555f; text-decoration: none; font-weight: 500; font-size: 0.92rem;
    transition: color 0.15s ease;
  }
  .main-nav a:hover { color: var(--heading); }
  .header-call {
    display: flex; align-items: center; gap: 0.6rem;
    background: var(--primary); color: #fff; text-decoration: none;
    padding: 0.52rem 1.1rem; border-radius: 11px;
    box-shadow: 0 4px 14px rgba(13, 148, 168, 0.3);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .header-call:hover { background: var(--primary-deep); transform: translateY(-1px); }
  .header-call-text { display: flex; flex-direction: column; line-height: 1.15; }
  .header-call-text strong { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: #fff; letter-spacing: -0.01em; white-space: nowrap; }
  .header-call-text small { font-size: 0.62rem; letter-spacing: 0.07em; text-transform: uppercase; opacity: 0.85; }

  .open-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--pulse); flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.55);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  /* ---------- buttons ---------- */
  .btn-call {
    display: inline-block;
    background: var(--primary); color: #fff; text-decoration: none;
    font-family: var(--font-display); font-weight: 700; font-size: 1rem;
    letter-spacing: -0.01em;
    padding: 0.95rem 1.9rem; border-radius: 13px;
    box-shadow: 0 8px 26px rgba(13, 148, 168, 0.35);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-call:hover { background: var(--primary-deep); transform: translateY(-2px); box-shadow: 0 12px 32px rgba(13, 148, 168, 0.4); }
  .btn-ghost {
    display: inline-block;
    background: #ffffff;
    border: 1px solid var(--line); color: var(--heading); text-decoration: none;
    font-family: var(--font-display); font-weight: 600; font-size: 0.96rem;
    padding: 0.95rem 1.7rem; border-radius: 13px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-ghost:hover { border-color: #c9d6db; transform: translateY(-2px); box-shadow: 0 8px 22px rgba(14, 36, 51, 0.08); }

  /* ---------- sections ---------- */
  section { padding: 5.5rem 0; }
  .section-deep { background: #ffffff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

  .waterline { display: none; }

  /* ---------- cards ---------- */
  /* Columns come from the card count (evenCols() in src/lib/grid.ts) so every
     row is full at every width; a card never gets narrower than 255px. */
  .card-grid {
    display: grid; gap: 1.1rem;
    grid-template-columns: 1fr;
    margin-top: 2.8rem;
  }
  @media (min-width: 640px) { .card-grid.t2 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 860px) { .card-grid.m3 { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1140px) { .card-grid.d4 { grid-template-columns: repeat(4, 1fr); } }
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.7rem 1.5rem;
    text-decoration: none;
    display: flex; flex-direction: column; gap: 0.7rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(13, 148, 168, 0.35);
  }
  .card h3 { font-size: 1.12rem; }
  .card p { font-size: 0.92rem; line-height: 1.6; }
  .card .card-cta {
    margin-top: auto;
    font-family: var(--font-body); font-weight: 600;
    font-size: 0.8rem; letter-spacing: 0.01em; text-transform: none;
    color: var(--primary-deep);
  }
  .card svg {
    width: 44px; height: 44px;
    background: var(--tint);
    border-radius: 12px;
    padding: 9px;
  }

