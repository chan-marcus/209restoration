---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base
  title="209 Restoration | Water Damage Guides"
  description="Plain-language guides for Central Valley homeowners: what to do in the first hour of a water emergency, how insurance actually works, and more."
>
  <section>
    <div class="wrap">
      <span class="eyebrow">Guides</span>
      <h1>Read now or read wet</h1>
      <p class="lede">Plain-language answers for Valley homeowners. Best read before you need them, still useful after.</p>
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`}>
            <p class="mono post-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).toUpperCase()}</p>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="card-cta mono">Read guide &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .lede { max-width: 58ch; margin-top: 1rem; font-size: 1.1rem; }
  /* Rows always end full (even card grids): when the count doesn't divide,
     the newest post takes the leftover space, full width or two columns. */
  .post-list { margin-top: 2.5rem; display: grid; gap: 1.1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) and (max-width: 923.98px) {
    .post-list { grid-template-columns: repeat(2, 1fr); }
    .post-list > .post-card:first-child:nth-last-child(odd):not(:only-child) { grid-column: 1 / -1; }
  }
  @media (min-width: 924px) {
    .post-list { grid-template-columns: repeat(3, 1fr); }
    .post-list:has(> .post-card:last-child:nth-child(3n+1)) > .post-card:first-child { grid-column: 1 / -1; }
    .post-list:has(> .post-card:last-child:nth-child(3n+2)) > .post-card:first-child { grid-column: span 2; }
  }
  .post-card {
    border: 1px solid var(--line); border-radius: 16px; background: #ffffff;
    padding: 1.8rem; text-decoration: none; display: block;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(13, 148, 168, 0.35);
  }
  .post-card h2 { font-size: 1.4rem; color: var(--paper); margin: 0.4rem 0 0.6rem; }
  .post-card p { font-size: 0.97rem; color: #43555f; max-width: 60ch; } /* the full-width newest post reads like a paragraph */
  .post-date { font-size: 0.65rem; }
  .post-card .card-cta { display: inline-block; margin-top: 1rem; font-size: 0.72rem; letter-spacing: 0.01em; text-transform: none; font-weight: 600; color: var(--cyan); }
</style>
