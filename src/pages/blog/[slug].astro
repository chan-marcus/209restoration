---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SITE } from '../../config/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const canonical = `https://209restoration.com/blog/${post.slug}/`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString().split('T')[0],
  dateModified: post.data.date.toISOString().split('T')[0],
  mainEntityOfPage: canonical,
  image: post.data.image ? `https://209restoration.com${post.data.image}` : 'https://209restoration.com/og.png',
  author: { '@type': 'Organization', name: '209 Restoration', url: 'https://209restoration.com' },
  publisher: {
    '@type': 'Organization',
    name: '209 Restoration',
    logo: { '@type': 'ImageObject', url: 'https://209restoration.com/icon-512.png' }
  }
};
const crumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://209restoration.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://209restoration.com/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical }
  ]
};
---
<Base title={`${post.data.title} | 209 Restoration`} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />
  <section class="post-section">
    <div class="wrap">
      <div class="post-layout">
        <div class="post-main">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a> <span aria-hidden="true">/</span> <a href="/blog/">Guides</a>
          </nav>
          <p class="post-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          <article class="post">
            <h1>{post.data.title}</h1>
            <Content />
          </article>
        </div>
        <aside class="post-sidebar">
          <div class="sidebar-card sticky-card">
            <p class="sidebar-label">Water emergency?</p>
            <a class="btn-call sidebar-btn" href={`tel:${SITE.phone}`}>Call {SITE.phoneDisplay}</a>
            <p class="sidebar-open"><span class="open-dot" aria-hidden="true"></span> Open 24/7</p>
            <hr class="sidebar-rule" />
            <p class="sidebar-label">More guides</p>
            <nav class="sidebar-links">
              <a href="/blog/">All guides &rarr;</a>
              <a href="/services/">Our services &rarr;</a>
              <a href="/areas/">Service areas &rarr;</a>
              <a href="/contact/">Contact us &rarr;</a>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .post-section { padding-top: 3rem; padding-bottom: 1rem; }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3.5rem;
    align-items: start;
  }

  /* main column */
  .crumbs {
    font-size: 0.78rem; color: var(--silt);
    margin-bottom: 1.2rem; display: flex; gap: 0.5rem; align-items: center;
  }
  .crumbs a { color: var(--silt); text-decoration: none; }
  .crumbs a:hover { color: var(--primary); }
  .crumbs span { opacity: 0.5; }
  .post-date { font-size: 0.78rem; color: var(--silt); margin-bottom: 1.5rem; }
  .post { margin-bottom: 3rem; }
  .post h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    line-height: 1.1; letter-spacing: -0.025em;
    margin-bottom: 0.3rem;
  }
  .post :global(h2) {
    font-size: 1.5rem; margin-top: 2.2em; margin-bottom: 0.5em;
    letter-spacing: -0.02em;
  }
  .post :global(p) { margin-top: 1em; color: #33454f; font-size: 1.05rem; line-height: 1.82; }
  .post :global(ul), .post :global(ol) { padding-left: 1.4em; margin-top: 0.9em; }
  .post :global(li) { margin-top: 0.55em; color: #33454f; line-height: 1.75; }
  .post :global(li strong), .post :global(p strong) { color: var(--heading); }
  .post :global(a) { color: var(--primary); }
  .post :global(img) {
    display: block; width: 100%; height: auto;
    margin: 2.2rem 0 0.5rem;
    border: 1px solid var(--line); border-radius: 16px;
    box-shadow: 0 8px 32px rgba(14,36,51,0.09);
  }
  .post :global(figure) { margin: 2rem 0; }
  .post :global(figcaption) { font-size: 0.8rem; color: #7a919d; margin-top: 0.6rem; }

  /* sidebar */
  .post-sidebar { }
  .sticky-card {
    position: sticky; top: 5.5rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.6rem;
    box-shadow: var(--shadow-lg);
  }
  .sidebar-label {
    font-family: var(--font-body); font-weight: 600;
    font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: #7a919d; margin-bottom: 0.75rem;
  }
  .sidebar-btn {
    display: block; text-align: center;
    font-size: 0.98rem; padding: 0.8rem 1rem;
    border-radius: 11px;
  }
  .sidebar-open {
    display: flex; align-items: center; justify-content: center;
    gap: 0.45rem; margin-top: 0.75rem;
    font-size: 0.75rem; font-weight: 500; color: var(--silt);
  }
  .sidebar-rule {
    border: none; border-top: 1px solid var(--line);
    margin: 1.3rem 0 1.1rem;
  }
  .sidebar-links { display: flex; flex-direction: column; gap: 0.45rem; }
  .sidebar-links a {
    font-size: 0.9rem; color: var(--heading); text-decoration: none;
    font-weight: 500; padding: 0.3rem 0;
    transition: color 0.15s ease;
  }
  .sidebar-links a:hover { color: var(--primary); }

  @media (max-width: 860px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-sidebar { display: none; }
  }
</style>
