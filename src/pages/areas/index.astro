---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { CITIES } from '../../data/cities';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://209restoration.com/' },
    { '@type': 'ListItem', position: 2, name: 'Areas', item: 'https://209restoration.com/areas/' }
  ]
};
---
<Base
  title="209 Restoration | Service Areas | Stockton, Modesto, Lodi, Tracy & the 209"
  description="24/7 water damage restoration dispatch across San Joaquin and Stanislaus Counties: Stockton, Modesto, Lodi, Tracy, Manteca, Turlock, Lathrop, and Ceres."
  schema={[breadcrumb]}
>
  <section>
    <div class="wrap">
      <span class="eyebrow">San Joaquin + Stanislaus Counties</span>
      <h1>Where crews respond</h1>
      <p class="lede">Local crews stationed across the Valley, not routed in from the Bay. Each city page covers the specific ways homes there take on water, from Delta groundwater to Tuolumne floodplain to hard-water slab leaks.</p>
      <div class="card-grid">
        {CITIES.map((c) => (
          <a class="card" href={`/areas/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p class="mono county">{c.county.toUpperCase()}</p>
            <p>{c.short}</p>
            <span class="card-cta">LOCAL PAGE &rarr;</span>
          </a>
        ))}
      </div>
      <p class="edge-note">On the edge of the map? Crews regularly cover Ripon, Escalon, Oakdale, Riverbank, Salida, Mountain House, Galt, and the unincorporated pockets in between. Call and dispatch will tell you straight whether a crew can reach you.</p>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .lede { max-width: 62ch; margin-top: 1rem; font-size: 1.1rem; }
  .county { font-size: 0.65rem; margin-top: -0.35rem; }
  .edge-note { margin-top: 2.2rem; max-width: 68ch; font-size: 0.95rem; }
</style>
