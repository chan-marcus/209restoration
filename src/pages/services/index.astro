---
import Base from '../../layouts/Base.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/services';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://209restoration.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://209restoration.com/services/' }
  ]
};
---
<Base
  title="Water Damage & Restoration Services | 209 Restoration"
  description="Every restoration service available 24/7 across Stockton, Modesto, and the 209: water removal, flood cleanup, sewage, burst pipes, mold, storm damage, and more."
  schema={[breadcrumb]}
>
  <section>
    <div class="wrap">
      <span class="eyebrow">24/7 across the 209</span>
      <h1>Restoration services</h1>
      <p class="lede">Water finds a lot of ways into a house. Pick the one that found yours; each page covers what the crew does, insurance realities, and what to do before they arrive.</p>
      <div class="card-grid">
        {SERVICES.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <ServiceIcon icon={s.icon} />
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="card-cta">DETAILS &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .lede { max-width: 62ch; margin-top: 1rem; font-size: 1.1rem; }
</style>
