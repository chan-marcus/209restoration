---
import Base from '../../layouts/Base.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/services';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://209restoration.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://209restoration.com/services/' }
  ]
};
---
<Base
  title="Water Damage Restoration Services | 24 Hour | Stockton & Modesto"
  description="Every water damage restoration service available 24 hours a day across Stockton, Modesto, Lodi, Manteca and the 209: emergency water removal, flood damage cleanup, water damage repair, sewage, burst pipes, mold removal, storm damage, and board up."
  schema={[breadcrumb]}
>
  <section>
    <div class="wrap">
      <span class="eyebrow">24/7 across the 209</span>
      <h1>Water damage restoration services</h1>
      <p class="lede">A full damage restoration service for the 209, from the first hour of extraction through drying, mold removal, and repair. Water finds a lot of ways into a house; pick the one that found yours, and each page covers what the crew does, insurance realities, and what to do before they arrive.</p>
      <div class="card-grid">
        {SERVICES.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <ServiceIcon icon={s.icon} />
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="card-cta">DETAILS &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .lede { max-width: 62ch; margin-top: 1rem; font-size: 1.1rem; }
</style>
